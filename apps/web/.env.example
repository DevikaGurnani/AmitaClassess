NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# SERVER ONLY. Never prefix these with NEXT_PUBLIC_ or commit actual values.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Set these only locally when running scripts/create-academy-account.mjs.
# ACADEMY_ACCOUNT_PHONE=+919876543210
# ACADEMY_ACCOUNT_EMAIL=admin@example.com
# ACADEMY_ACCOUNT_NAME=Academy Administrator
# ACADEMY_ACCOUNT_ROLE=owner
# ACADEMY_ACCOUNT_PASSWORD=set-your-private-owner-password
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_SEPARATE_RAZORPAY_WEBHOOK_SECRET
CRON_SECRET=YOUR_LONG_RANDOM_CRON_TOKEN

# Optional: HTTPS adapter which authenticates with the bearer token supplied.
# Adapter must return JSON {"messageId":"..."} on accepted delivery.
# WhatsApp templates/provider approvals are managed in that adapter.
NOTIFICATION_DELIVERY_WEBHOOK_URL=
NOTIFICATION_DELIVERY_WEBHOOK_TOKEN=
