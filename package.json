{
  "name": "tuition-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "node -e \"console.error('Mobile app is not implemented yet'); process.exit(1)\"",
    "build:web": "npm run build --workspace=apps/web",
    "build:mobile": "node -e \"console.error('Mobile app is not implemented yet'); process.exit(1)\"",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:studio": "supabase studio",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:phase3": "node scripts/phase3-test.mjs",
    "test:demo": "node scripts/live-only-auth-test.mjs",
    "test:live-only": "node scripts/live-only-auth-test.mjs",
    "test:console": "node scripts/console-test.mjs",
    "test:student-console": "node scripts/student-console-db-test.mjs",
    "test:accounts": "node scripts/account-password-test.mjs",
    "test:password-login": "node scripts/password-login-test.mjs",
    "test:database-setup": "node scripts/database-upgrade-test.mjs",
    "test:assignments": "node scripts/assignments-test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "pg": "^8.23.1",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
